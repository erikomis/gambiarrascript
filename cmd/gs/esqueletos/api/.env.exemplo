# Copie pra .env e ajuste: cp .env.exemplo .env
# O .env nao vai pro git; variavel que ja existe no ambiente ganha do arquivo.

# porta HTTP (a flag --porta ganha desta)
PORTA=8080

# banco: sqlite:arquivo.db, postgres://user:senha@host/db ou mysql://user:senha@host:3306/db
# (as migracoes e as consultas de exemplo foram escritas pro sqlite)
GS_BANCO=sqlite:dados/app.db

# segredo que assina os tokens JWT. Vazio = sorteia um a cada subida (os
# tokens morrem no restart). Gere um com: openssl rand -base64 32
JWT_SEGREDO=

# log: debug, info, aviso ou erro; GS_LOG_FORMATO=json pra coletor de log
GS_LOG_NIVEL=info
# GS_LOG_FORMATO=json
