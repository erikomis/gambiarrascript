#!/usr/bin/env bash
# Monta os arquivos de release em dist/release/ (usa Go local; e o que o
# workflow release.yml roda, mas da pra rodar na maquina pra conferir):
#   gs_<versao>_<os>_<arch>.tar.gz  (zip no windows) com o binario + README.md
#   checksums.txt                   sha256 de tudo (inclui *.vsix se ja estiver la)
#   gambiarrascript.rb              formula Homebrew preenchida com os sha256
# Uso: scripts/release 1.2.3   (o "v" na frente e opcional)
set -euo pipefail
cd "$(dirname "$0")/.."

VERSAO="${1:?uso: scripts/release <versao>  (ex: 1.2.3)}"
VERSAO="${VERSAO#v}"
case "$VERSAO" in
  *[!0-9A-Za-z.+-]*) echo "versao invalida: $VERSAO" >&2; exit 1 ;;
esac

OUT="${OUT:-dist/release}"
mkdir -p "$OUT"
OUT=$(cd "$OUT" && pwd)
# limpa so o que este script gera (um .vsix posto antes fica)
rm -f "$OUT"/gs_* "$OUT/checksums.txt" "$OUT/gambiarrascript.rb"

# no macOS o tar enfia ._arquivos de xattr; isso desliga
export COPYFILE_DISABLE=1

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

for alvo in darwin/arm64 darwin/amd64 linux/amd64 linux/arm64 windows/amd64; do
  os=${alvo%/*}
  arch=${alvo#*/}
  nome="gs_${VERSAO}_${os}_${arch}"
  bin=gs
  [ "$os" = windows ] && bin=gs.exe
  stage="$tmp/$nome"
  mkdir -p "$stage"

  echo "==> $os/$arch -> $nome"
  # CGO_ENABLED=0: binario estatico; o sqlite do "banco" e o modernc (Go puro)
  CGO_ENABLED=0 GOOS="$os" GOARCH="$arch" go build -trimpath \
    -ldflags "-s -w -X main.Versao=$VERSAO" -o "$stage/$bin" ./cmd/gs
  cp README.md "$stage/"

  if [ "$os" = windows ]; then
    (cd "$stage" && zip -q -X "$OUT/$nome.zip" "$bin" README.md)
  else
    tar -czf "$OUT/$nome.tar.gz" -C "$stage" "$bin" README.md
  fi
done

sha256() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$@"; else shasum -a 256 "$@"; fi
}

(
  cd "$OUT"
  shopt -s nullglob
  sha256 gs_* ./*.vsix | sed 's|  \./|  |' > checksums.txt
)

# formula Homebrew com os sha256 reais
sha_de() { awk -v f="gs_${VERSAO}_$1.tar.gz" '$2 == f { print $1 }' "$OUT/checksums.txt"; }
sed -e "s/__VERSAO__/$VERSAO/" \
  -e "s/__SHA256_DARWIN_ARM64__/$(sha_de darwin_arm64)/" \
  -e "s/__SHA256_DARWIN_AMD64__/$(sha_de darwin_amd64)/" \
  -e "s/__SHA256_LINUX_ARM64__/$(sha_de linux_arm64)/" \
  -e "s/__SHA256_LINUX_AMD64__/$(sha_de linux_amd64)/" \
  packaging/homebrew/gambiarrascript.rb > "$OUT/gambiarrascript.rb"

echo
echo "release $VERSAO pronta em $OUT:"
cat "$OUT/checksums.txt"
